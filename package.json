{
  "name": "track-spec",
  "version": "1.0.0",
  "private": true,
  "description": "Forza Horizon tuning calculator + live telemetry PWA",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"vite --host\" \"node server.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "npm run build && node server.js",
    "import:garage": "node scripts/scrape-forzagarage.cjs --details --local-images",
    "import:garage:images": "node scripts/download-garage-images.cjs",
    "import:garage:mastery": "node scripts/patch-garage-mastery.cjs && node scripts/download-perk-icons.cjs",
    "import:garage:specs": "node scripts/patch-garage-specs.cjs",
    "import:garage:brands": "node scripts/download-brand-logos.cjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
